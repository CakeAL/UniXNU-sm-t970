  "findings": [
    "Both inspected startup configurations enable OWNER_UNION_SYSTEMOS together with CACHE_MOUNT/STARTUP/BOOT_MANIFEST and NATIVE_CS_HASH_CACHE.",
    "T733 separately fixes kernproc cwd/rootvnode shared-reference ownership during checkdirs. Our selected XNU has the same uncorrected ownership transfer.",
    "Current shared zzyb-native-cryptex-os-view.patch builds a later Data-backed cryptex alias; the raw OS symlink is not a standalone mount directory."
  ],
  "limits": [
    "External device success is maintainer-reported, not validated on T970.",
