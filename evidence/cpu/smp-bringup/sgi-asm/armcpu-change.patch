 Build and interface details: [documentation](https://unixnu.com/reference/components). Component sources and dependencies: [catalog](https://unixnu.com/reference/components).
+
+## Darwin inline assembly separators
+
+Multi-instruction inline assembly uses explicit `\n\t` separators. With the
+reviewed Apple arm64 assembler, semicolon-separated strings emitted only the
+first instruction. This omitted ICC_SGI1R_EL1 writes after DSB, counter reads
+after ISB, and required synchronization after register writes.
+
+Audit the actual ArmCpu object and final payload for SGI writes, counter reads,
+DAIF restore/masking and their barriers. Source expressions or send counters do
+not establish that the corresponding system-register instructions were emitted.
+Hardware IPI delivery and SMP scheduling require separate device observations.
diff --git a/tests/test-asm-object.py b/tests/test-asm-object.py
new file mode 100644
index 0000000..ef92031
--- /dev/null
+++ b/tests/test-asm-object.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Audit actual ArmCpu object/kernel instructions, not just source or send counters."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+p=argparse.ArgumentParser(description=__doc__);p.add_argument('--binary',type=Path,required=True);p.add_argument('--output',type=Path,required=True);a=p.parse_args()
+a.output.mkdir(parents=True,exist_ok=False)
+nm='/opt/homebrew/opt/llvm/bin/llvm-nm';dump='/opt/homebrew/opt/llvm/bin/llvm-objdump'
+names=[line.split()[-1] for line in subprocess.check_output([nm,'--defined-only',str(a.binary)],text=True).splitlines() if line.split()]
+def body(fragment):
+ candidates=[n for n in names if (n==fragment if fragment.startswith('_armcpu_') else n.startswith('__ZN6ArmCpu') and fragment in n) and '.cold.' not in n]
+ assert len(candidates)==1,(fragment,candidates)
+ text=subprocess.check_output([dump,'-d','--disassemble-symbols='+candidates[0],str(a.binary)],text=True)
+ (a.output/(fragment+'.txt')).write_text(text)
+ return text.lower()
+for fn in ('__ZN6ArmCpu9signalCPU','_armcpu_ipi_selftest'):
+ text=body(fn)
+ assert re.search(r'dsb\s+ishst[^\n]*\n[^\n]*msr\s+icc_sgi1r_el1[^\n]*\n[^\n]*isb',text),fn
+text=body('__ZN6ArmCpu9enableGic')
+assert re.search(r'msr\s+icc_sre_el1[^\n]*\n[^\n]*isb',text)
+assert re.search(r'msr\s+icc_igrpen1_el1[^\n]*\n[^\n]*dsb\s+sy[^\n]*\n[^\n]*isb',text)
+text=body('enableCPUTimeBase')
+assert re.search(r'msr\s+cntv_ctl_el0[^\n]*\n[^\n]*isb',text)
+text=body('__ZN6ArmCpu10quiesceCPU')
+assert re.search(r'msr\s+icc_igrpen1_el1[^\n]*\n[^\n]*dsb\s+sy[^\n]*\n[^\n]*isb',text)
+text=body('_armcpu_sgi_selfprobe')
+for token in ('daifset','msr\tdaif,','icc_sgi1r_el1','icc_sgi0r_el1','cntvct_el0','icc_pmr_el1'):
+ assert token in text,token
+all_text=subprocess.check_output([dump,'-d',str(a.binary)],text=True).lower()
+assert re.search(r'isb[^\n]*\n[^\n]*mrs\s+[^\n]*cntvct_el0',all_text),'Counter read following ISB missing'
+report=dict(passed=True,binary_sha256=hashlib.sha256(a.binary.read_bytes()).hexdigest(),normal_and_diagnostic_sgi_write_emitted=True,sgi_ordering_barriers_emitted=True,gic_and_timer_isb_emitted=True,daif_mask_and_restore_emitted=True,counter_reads_emitted=True,hardware_ipi_delivery_verified=False)
+(a.output/'report.json').write_text(json.dumps(report,indent=2)+'\n');print('PASS: actual normal/diagnostic SGI writes, barriers, GIC/timer ISBs, DAIF mask/restore and counter reads')
