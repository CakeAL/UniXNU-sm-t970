+/* T970 opt-in: sample only the known 21H461 LaunchServices lock range.
+ * An identical page offset is only a candidate until the task slide agrees. */
+#define T970_LS_LOCK_BASE 0x1f4884878ULL
+#define T970_LS_CACHE_MAX_SLIDE 0x20000000ULL
+static unsigned t970_ls_sample_busy;
+static struct { uint64_t addr, waiter, owner, count; } t970_ls_sample;
+
+static void
+native_t970_ls_owner_note(uint64_t addr, thread_t self, thread_t owner)
+{
+	if (__atomic_exchange_n(&t970_ls_sample_busy, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	t970_ls_sample.addr = addr;
+	t970_ls_sample.waiter = thread_tid(self);
+	t970_ls_sample.owner = thread_tid(owner);
+	++t970_ls_sample.count;
+	__atomic_store_n(&t970_ls_sample_busy, 0, __ATOMIC_RELEASE);
+}
+
+void
+native_t970_ls_owner_text(char *out, unsigned length)
+{
+	if (__atomic_exchange_n(&t970_ls_sample_busy, 1, __ATOMIC_ACQUIRE)) {
+		snprintf(out, length, "\nLS owner sample busy");
+		return;
+	}
+	uint64_t addr = t970_ls_sample.addr;
+	uint64_t waiter = t970_ls_sample.waiter;
+	uint64_t owner = t970_ls_sample.owner;
+	uint64_t count = t970_ls_sample.count;
+	__atomic_store_n(&t970_ls_sample_busy, 0, __ATOMIC_RELEASE);
+	snprintf(out, length, "\nLS waits=%llu addr=%llx waiter=%llx owner=%llx",
+	    (unsigned long long)count, (unsigned long long)addr,
+	    (unsigned long long)waiter, (unsigned long long)owner);
+}
