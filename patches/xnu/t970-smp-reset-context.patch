+/* Read-only T970 secondary reset handoff observation. No CPU/power changes. */
+#if !CONFIG_SPTM
+void native_t970_reset_context(uint64_t *out);
+void
+native_t970_reset_context(uint64_t *out)
+{
+	out[0] = (uint64_t)ResetHandlerData.cpu_data_entries;
+	out[1] = (uint64_t)ml_static_vtop((vm_offset_t)CpuDataEntries);
+	out[2] = (uint64_t)(uintptr_t)CpuDataEntries[1].cpu_data_paddr;
+	cpu_data_t *cpu = CpuDataEntries[1].cpu_data_vaddr;
+	out[3] = cpu ? cpu->cpu_phys_id : 0;
+	out[4] = cpu ? cpu->cpu_reset_handler : 0;
+	out[5] = (uint64_t)ml_static_vtop((vm_offset_t)&start_cpu);
+}
+#endif
