 #pragma mark misc
 
+
+/* T970_WQ_DETAIL_BEGIN: read-only board bring-up; no scheduling changes. */
+int
+native_t970_workqueue_detail(proc_t p, uint64_t *out)
+{
+ struct workqueue *wq=proc_get_wqptr(p);
+ if(!wq)return EINVAL;
+ if(!workq_lock_try(wq))return EBUSY;
+ out[0]=wq->wq_reqcount;out[1]=_wq_flags(wq);
+ out[2]=wq->wq_thidlecount;out[3]=wq->wq_threads_scheduled;
+ out[4]=wq->wq_constrained_threads_scheduled;
+ out[5]=wq->wq_thread_call_last_run;out[6]=mach_absolute_time();
+ out[7]=wq->wq_timer_interval;
+ out[8]=wq->wq_creator?uthread_tid(wq->wq_creator):0;
+ out[9]=wq->wq_fulfilled;out[10]=wq->wq_creations;
+ /* Queue heads and admission inputs only; never call the mutating selector. */
+ workq_threadreq_t req=priority_queue_max(&wq->wq_constrained_queue,struct workq_threadreq_s,tr_entry);
+ if(req) {
+  out[11]=req->tr_qos;out[12]=req->tr_flags;out[13]=req->tr_count;
+  if(req->tr_qos>=WORKQ_THREAD_QOS_MIN && req->tr_qos<=WORKQ_THREAD_QOS_MAX) {
+   uint32_t busy=0;
+   out[14]=wq_max_parallelism[_wq_bucket(req->tr_qos)];
+   out[15]=_wq_thactive_aggregate_downto_qos(wq,_wq_thactive(wq),req->tr_qos,&busy,NULL);
+   out[16]=busy;
+  }
+ }
+ out[17]=wq_max_constrained_threads;
+ req=priority_queue_max(&wq->wq_overcommit_queue,struct workq_threadreq_s,tr_entry);
+ if(req){out[18]=req->tr_qos;out[19]=req->tr_flags;out[20]=req->tr_count;}
+ req=priority_queue_max(&wq->wq_special_queue,struct workq_threadreq_s,tr_entry);
+ if(req){out[21]=req->tr_qos;out[22]=req->tr_flags;out[23]=req->tr_count;}
+ out[24]=wq->wq_event_manager_threadreq!=NULL;
+ out[25]=wq->wq_cooperative_queue_best_req_qos;
+ for(unsigned i=0;i<WORKQ_NUM_QOS_BUCKETS;i++)out[26]+=wq->wq_cooperative_queue_scheduled_count[i];
+ out[27]=wq->wq_cooperative_queue_has_limited_max_size;
+ workq_unlock(wq);return 0;
+}
+/* T970_WQ_DETAIL_END */
