@@ -4692,6 +4692,25 @@
 
 #pragma mark misc
 
+
+/* T970_WQ_DETAIL_BEGIN: read-only board bring-up; no scheduling changes. */
+int
+native_t970_workqueue_detail(proc_t p, uint64_t *out)
+{
+ struct workqueue *wq=proc_get_wqptr(p);
+ if(!wq)return EINVAL;
+ if(!workq_lock_try(wq))return EBUSY;
+ out[0]=wq->wq_reqcount;out[1]=_wq_flags(wq);
+ out[2]=wq->wq_thidlecount;out[3]=wq->wq_threads_scheduled;
+ out[4]=wq->wq_constrained_threads_scheduled;
+ out[5]=wq->wq_thread_call_last_run;out[6]=mach_absolute_time();
+ out[7]=wq->wq_timer_interval;
+ out[8]=wq->wq_creator?uthread_tid(wq->wq_creator):0;
+ out[9]=wq->wq_fulfilled;out[10]=wq->wq_creations;
+ workq_unlock(wq);return 0;
+}
+/* T970_WQ_DETAIL_END */
