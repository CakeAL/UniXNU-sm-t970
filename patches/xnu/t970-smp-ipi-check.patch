+struct native_t970_ipi_snapshot {
+	uint64_t sent, tested, received;
+	uint32_t attempted, before, after, gic[8];
+};
+static void
+native_t970_ipi_check(struct native_t970_ipi_snapshot *out)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("t970-ipi-check", &enabled, sizeof(enabled)) || enabled != 1) return;
+	extern volatile uint64_t armcpu_ipi_sent, armcpu_ipi_selftest_sent, armcpu_ipi_interrupts;
+	extern void armcpu_ipi_selftest(uint64_t affinity);
+	extern void armcpu_gic_diag(uint64_t affinity, uint32_t *values);
+	if (processor_avail_count < 2 || armcpu_smp_step[1] != 7) {
+		out->attempted = 2;
+		return;
+	}
+	out->before = armcpu_core_sgi[1];
+	armcpu_ipi_selftest(0x100);
+	out->attempted = 1;
+	uint64_t deadline;
+	clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+	if (assert_wait_deadline((event_t)out, THREAD_UNINT, deadline) == THREAD_WAITING) {
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	out->after = armcpu_core_sgi[1];
+	armcpu_gic_diag(0x100, out->gic);
+	out->sent = armcpu_ipi_sent;
+	out->tested = armcpu_ipi_selftest_sent;
+	out->received = armcpu_ipi_interrupts;
+}
+
 static uint32_t native_t970_runtime_started;
