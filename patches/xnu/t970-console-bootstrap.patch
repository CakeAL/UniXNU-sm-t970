@@ -574,11 +574,22 @@
 		(void)switch_to_serial_console(); /* Switch into serial mode from video console */
 		disableConsoleOutput = FALSE;     /* Allow printfs to happen */
 	}
-	PE_create_console();
-
-	/* setup console output */
+	/* Install the output callback before console setup can emit text. */
 	PE_init_printf(FALSE);
 
+	/*
+	 * T970 diagnostic: the Apple video console path spins inside
+	 * check_for_panic_log/gc_enable before the console exists, and a panic on
+	 * that path is silent. Skip all console setup when the boot argument is
+	 * present; the panic screen remains the only output channel.
+	 */
+	{
+		unsigned int novc = 0;
+		if (!PE_parse_boot_argn("t970-novc", &novc, sizeof(novc))) {
+			PE_create_console();
+		}
+	}
