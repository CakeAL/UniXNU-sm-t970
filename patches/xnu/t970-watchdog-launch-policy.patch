+		native_t970_watchdog_policy_status = native_t970_watchdog_policy_prepare(p, (user_addr_t)scratch_addr);
+		if (native_t970_watchdog_policy_status) panic("watchdog launch policy err=%d stage=%d",
+		    native_t970_watchdog_policy_status, native_t970_watchdog_policy_stage);
+	}
 #endif
