+/* Observe the seven CPU1 values captured before the high-VA branch. */
+void native_t970_trampoline_snapshot(uint64_t *out);
+void
+native_t970_trampoline_snapshot(uint64_t *out)
+{
+	flush_dcache((vm_offset_t)native_t970_secondary_entry, sizeof(native_t970_secondary_entry), FALSE);
+	for (unsigned i = 0; i < 7; ++i) {
+		out[i] = (uint64_t)native_t970_secondary_entry[1][2 + 2 * i] |
+		    ((uint64_t)native_t970_secondary_entry[1][3 + 2 * i] << 32);
+	}
+	__asm__ volatile ("mrs %0, ttbr1_el1" : "=r" (out[7]));
+}
