+/* T970_CACHE_TRACE_BEGIN: CPU0/initproc diagnostic, no extra user-memory reads. */
+#define T970_CACHE_TRACE_ROWS 24
+static char native_t970_cache_paths[64];
+static char native_t970_cache_rows[T970_CACHE_TRACE_ROWS][128];
+static unsigned native_t970_cache_count;
+void native_t970_cache_path_note(proc_t, const char *);
+const char *native_t970_cache_trace_text(void);
+void
+native_t970_cache_path_note(proc_t p, const char *path)
+{
+	if (!p || proc_getpid(p) != 1) return;
+	/* namei calls only after its own successful copy and length validation. */
+	size_t length = strlen(path);
+	strlcpy(native_t970_cache_paths, length > 63 ? path + length - 63 : path,
+	    sizeof(native_t970_cache_paths));
+}
+static void
+native_t970_cache_syscall_note(proc_t p, unsigned code, int error, uthread_t ut)
+{
+	if (!p || proc_getpid(p) != 1) return;
+	switch (code) {
+	case SYS_open: case SYS_open_nocancel: case SYS_openat: case SYS_openat_nocancel:
+	case SYS_fcntl: case SYS_fcntl_nocancel:
+	case SYS_shared_region_check_np: case SYS_shared_region_map_and_slide_2_np:
+		break;
+	default:
+		return;
+	}
+	int command = (code == SYS_fcntl || code == SYS_fcntl_nocancel) ? (int)ut->uu_arg[1] : 0;
+	int argument = (code == SYS_open || code == SYS_open_nocancel) ? 0 : (int)ut->uu_arg[0];
+	unsigned slot = os_atomic_inc_orig(&native_t970_cache_count, relaxed);
+	snprintf(native_t970_cache_rows[slot % T970_CACHE_TRACE_ROWS],
+	    sizeof(native_t970_cache_rows[0]), "sc%u e%d r%x a%d c%d %s",
+	    code, error, ut->uu_rval[0], argument, command,
+	    native_t970_cache_paths[0] ? native_t970_cache_paths : "(no path note)");
+}
+const char *
+native_t970_cache_trace_text(void)
+{
+	static char result[1664];
+	unsigned count = native_t970_cache_count;
+	unsigned first = count > 12 ? count - 12 : 0;
+	size_t used = (size_t)snprintf(result, sizeof(result), "init cache syscalls=%u", count);
+	for (unsigned i = first; i < count && used < sizeof(result) - 1; ++i) {
+		int n = snprintf(result + used, sizeof(result) - used, "\n%s",
+		    native_t970_cache_rows[i % T970_CACHE_TRACE_ROWS]);
+		if (n < 0 || (size_t)n >= sizeof(result) - used) break;
+		used += (size_t)n;
+	}
+	return result;
+}
+/* T970_CACHE_TRACE_END */
 
