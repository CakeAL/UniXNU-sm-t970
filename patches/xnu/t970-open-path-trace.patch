--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -5131,2 +5131,18 @@
+char native_owner_open_paths[3][96];
+int native_owner_open_path_count;
+
+void
+native_owner_record_open_path(const char *path)
+{
+	if (!path || native_owner_open_path_count >= 3) {
+		return;
+	}
+	if (!strnstr(path, "dyld", 96) && !strnstr(path, "libSystem", 96)) {
+		return;
+	}
+	strlcpy(native_owner_open_paths[native_owner_open_path_count], path, 96);
+	native_owner_open_path_count++;
+}
+
 int
 open_nocancel(__unused proc_t p, struct open_nocancel_args *uap,
@@ -5136,2 +5152,8 @@
 {
+	{
+		char path[96];
+		if (copyinstr(uap->path, path, sizeof(path), NULL) == 0) {
+			native_owner_record_open_path(path);
+		}
+	}
 	return openat_internal(vfs_context_current(), uap->path, uap->flags,
