+/* Read-only per-core evidence for staged SMP bring-up. */
+extern uint32_t processor_avail_count;
+extern volatile uint32_t armcpu_smp_running, armcpu_smp_step[8], armcpu_smp_fail[8];
+extern volatile int32_t armcpu_smp_psci_rc[8];
+extern volatile uint32_t armcpu_core_timer[8], armcpu_core_sgi[8];
+static void
+native_t970_smp_state(char *buffer, size_t capacity)
+{
+	if (!capacity) return;
+	buffer[0] = 0;
+	size_t used = 0;
+	for (unsigned i = 0; i < 8 && used < capacity - 1; ++i) {
+		size_t remaining = capacity - used;
+		int n = snprintf(buffer + used, remaining, "%u:%u/%d/%u/%u/%u ", i,
+		    armcpu_smp_step[i], armcpu_smp_psci_rc[i], armcpu_smp_fail[i],
+		    armcpu_core_timer[i], armcpu_core_sgi[i]);
+		if (n <= 0) break;
+		used += (size_t)n < remaining ? (size_t)n : remaining - 1;
+	}
+}
