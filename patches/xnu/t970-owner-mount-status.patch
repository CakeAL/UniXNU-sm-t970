--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8181,7 +8181,21 @@
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
-	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
+	{
+		extern const char *native_ufs_cache_probe_text(void);
+		/* Kernel-context lookups start at the global root; the process context starts at pid 1's
+		 * root. If these disagree, the union is not on the path that dyld resolves. */
+		const char *cache_path = "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64";
+		vnode_t kernel_vnode = NULLVP, proc_vnode = NULLVP;
+		int kernel_lookup = vnode_lookup(cache_path, 0, &kernel_vnode, vfs_context_kernel());
+		int proc_lookup = vnode_lookup(cache_path, 0, &proc_vnode, vfs_context_current());
+		if (kernel_vnode) vnode_put(kernel_vnode);
+		if (proc_vnode) vnode_put(proc_vnode);
+		panic("offline owner cache: mount=%d stage=%d auth=%d mstatus=%d kernel=%d process=%d %s",
+		    cache_error, native_owner_cache_stage, native_owner_cache_authorized,
+		    native_owner_cache_mount_status, kernel_lookup, proc_lookup,
+		    native_ufs_cache_probe_text());
+	}
 #endif
 #if defined(XNU_OWNER_DATA_MOUNT) && XNU_OWNER_DATA_MOUNT
 	int data_error = native_owner_data_prepare(p, (user_addr_t)scratch_addr);
