--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8181,7 +8181,27 @@
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
-	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
+	{
+		extern const char *native_ufs_cache_probe_text(void);
+		extern char native_owner_cache_device_path[];
+		/* dyld resolves one of these three layouts; report all of them so the mount point can
+		 * be chosen from evidence instead of guesswork. */
+		const char *paths[3] = {
+			"/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+			"/System/Cryptexes/OS/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+			"/private/preboot/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		};
+		int looked[3] = { -1, -1, -1 };
+		for (int i = 0; i < 3; i++) {
+			vnode_t probe = NULLVP;
+			looked[i] = vnode_lookup(paths[i], 0, &probe, vfs_context_current());
+			if (probe) vnode_put(probe);
+		}
+		panic("offline owner cache: mount=%d stage=%d auth=%d mstatus=%d sys=%d cryptex=%d preboot=%d %s",
+		    cache_error, native_owner_cache_stage, native_owner_cache_authorized,
+		    native_owner_cache_mount_status, looked[0], looked[1], looked[2],
+		    native_ufs_cache_probe_text());
+	}
 #endif
