+void native_t970_runtime_report_request(void);
+void
+native_t970_runtime_report_request(void)
+{
+	kern_return_t error = native_t970_runtime_report_schedule(0);
+	if (error != KERN_SUCCESS && error != KERN_ALREADY_WAITING) {
+		printf("T970: Setup touch report scheduling failed: %d\n", error);
+	}
+}
