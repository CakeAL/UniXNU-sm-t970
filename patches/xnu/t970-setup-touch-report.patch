+static kern_return_t
+native_t970_runtime_report_schedule(unsigned seconds)
+{
+	if (__atomic_exchange_n(&native_t970_runtime_started, 1, __ATOMIC_ACQ_REL)) {
+		return KERN_ALREADY_WAITING;
+	}
+	thread_t thread = THREAD_NULL;
+	kern_return_t error = kernel_thread_start(native_t970_runtime_report, (void *)(uintptr_t)seconds, &thread);
+	if (error != KERN_SUCCESS) {
+		__atomic_store_n(&native_t970_runtime_started, 0, __ATOMIC_RELEASE);
+		return error;
+	}
+	thread_deallocate(thread);
+	return KERN_SUCCESS;
+}
