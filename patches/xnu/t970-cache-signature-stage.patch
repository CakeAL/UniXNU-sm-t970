+void
+native_t970_cs_note(unsigned stage, int error, off_t offset, const unsigned char *cdhash)
+{
+	if (error != EACCES || proc_selfpid() != 1 || native_t970_cs_failure[0]) return;
+	char hash[41] = {0};
+	const char hex[] = "0123456789abcdef";
+	if (cdhash) for (unsigned i = 0; i < 20; ++i) {
+		hash[i * 2] = hex[cdhash[i] >> 4];
+		hash[i * 2 + 1] = hex[cdhash[i] & 15];
+	}
+	snprintf(native_t970_cs_failure, sizeof(native_t970_cs_failure),
+	    "csig EACCES stage=%u off=%llx cd=%s", stage, (unsigned long long)offset,
+	    cdhash ? hash : "unavailable");
+}
+const char *
+native_t970_cs_failure_text(void)
+{
+	return native_t970_cs_failure[0] ? native_t970_cs_failure : "csig: no EACCES captured";
+}
