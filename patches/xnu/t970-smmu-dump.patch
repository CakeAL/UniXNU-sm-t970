--- a/osfmk/arm/arm_init.c	2026-11-01 09:47:38
+++ b/osfmk/arm/arm_init.c	2026-11-01 09:47:38
@@ -653,6 +653,30 @@
 	 * against string vulnerabilities
 	 */
 	__stack_chk_guard &= ~(0xFFULL << 8);
+
+	/*
+	 * T970 diagnostic: learn whether apps_smmu accepts writes at all. GFSR is
+	 * write-1-to-clear, so a successful write reads back zero; an unchanged
+	 * value means the block is locked, unclocked or not the SMMU.
+	 */
+	{
+		unsigned int t970_smmu_write = 0;
+		if (PE_parse_boot_argn("t970-smmu-write", &t970_smmu_write, sizeof(t970_smmu_write))) {
+			vm_offset_t base = ml_io_map_wcomb(0x15000000ULL, 0xd0000);
+			if (!base) {
+				panic("T970 SMMU write: map failed");
+			}
+			uint32_t idr_a = *(volatile uint32_t *)(base + 0x0);
+			uint32_t idr_b = *(volatile uint32_t *)(base + 0x0);
+			uint32_t gfsr_before = *(volatile uint32_t *)(base + 0x24);
+			*(volatile uint32_t *)(base + 0x24) = 0xffffffffU;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			uint32_t gfsr_after = *(volatile uint32_t *)(base + 0x24);
+			panic("T970 SMMU write idr_a=%08x idr_b=%08x gfsr_before=%08x gfsr_after=%08x",
+			    idr_a, idr_b, gfsr_before, gfsr_after);
+		}
+	}
+
 	machine_startup(args);
 }
 
