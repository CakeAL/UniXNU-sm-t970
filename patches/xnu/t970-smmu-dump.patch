--- a/osfmk/arm/arm_init.c	2026-11-01 10:18:19
+++ b/osfmk/arm/arm_init.c	2026-11-01 10:18:19
@@ -653,6 +653,24 @@
 	 * against string vulnerabilities
 	 */
 	__stack_chk_guard &= ~(0xFFULL << 8);
+
+	/*
+	 * T970 diagnostic: report the UEFI UFS bring-up status word that the
+	 * board PlatformUfsLib writes at 0x9ff80000, before any storage driver
+	 * runs. The panic screen is the only output channel on this board.
+	 */
+	{
+		unsigned int t970_ufs_status = 0;
+		if (PE_parse_boot_argn("t970-ufs-status", &t970_ufs_status, sizeof(t970_ufs_status))) {
+			vm_offset_t st = ml_io_map_wcomb(0x9FF80000ULL, 0x1000);
+			if (!st) {
+				panic("T970 UFS status: map failed");
+			}
+			panic("T970 UFS status magic=%08x status=%08x",
+			    *(volatile uint32_t *)(st + 0x0), *(volatile uint32_t *)(st + 0x4));
+		}
+	}
+
 	machine_startup(args);
 }
 
