+/* Opt-in Setup lifecycle recorder. Retain bounded numeric fields only. */
+static unsigned t970_setup_life_busy;
+static struct {
+ unsigned launches, exits, reason_ns;
+ int exec_pid, exec_error, exit_pid, wait_status;
+ uint64_t reason_code;
+} t970_setup_life;
+
+static void
+native_t970_setup_exec_note(proc_t child, int error)
+{
+ unsigned enabled = 0;
+ if (!PE_parse_boot_argn("t970-setup-life", &enabled, sizeof(enabled)) || enabled != 1) return;
+ if (__atomic_exchange_n(&t970_setup_life_busy, 1, __ATOMIC_ACQUIRE)) return;
+ ++t970_setup_life.launches;
+ t970_setup_life.exec_pid = child ? proc_getpid(child) : -1;
+ t970_setup_life.exec_error = error;
+ __atomic_store_n(&t970_setup_life_busy, 0, __ATOMIC_RELEASE);
+}
+
+void native_t970_setup_exit_note(int, int, unsigned, uint64_t);
+void
+native_t970_setup_exit_note(int pid, int status, unsigned reason_ns, uint64_t reason_code)
+{
+ unsigned enabled = 0;
+ if (!PE_parse_boot_argn("t970-setup-life", &enabled, sizeof(enabled)) || enabled != 1) return;
+ if (__atomic_exchange_n(&t970_setup_life_busy, 1, __ATOMIC_ACQUIRE)) return;
+ ++t970_setup_life.exits;
+ t970_setup_life.exit_pid = pid;
+ t970_setup_life.wait_status = status;
+ t970_setup_life.reason_ns = reason_ns;
+ t970_setup_life.reason_code = reason_code;
+ __atomic_store_n(&t970_setup_life_busy, 0, __ATOMIC_RELEASE);
+}
+
+void native_t970_setup_life_text(char *, unsigned);
+void
+native_t970_setup_life_text(char *out, unsigned length)
+{
+ if (__atomic_exchange_n(&t970_setup_life_busy, 1, __ATOMIC_ACQUIRE)) {
+  snprintf(out, length, "\nSetup lifecycle busy");
+  return;
+ }
+ __typeof__(t970_setup_life) state = t970_setup_life;
+ __atomic_store_n(&t970_setup_life_busy, 0, __ATOMIC_RELEASE);
+ snprintf(out, length, "\nSetup life exec=%u/%d/%d exit=%u/%d/%x reason=%u/%llx",
+     state.launches, state.exec_pid, state.exec_error, state.exits, state.exit_pid,
+     state.wait_status, state.reason_ns, (unsigned long long)state.reason_code);
+}
